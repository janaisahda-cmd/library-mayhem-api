{
  "info": {
    "name": "Library Mayhem API - Week 11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1" },
    { "key": "host", "value": "2099-1001" },
    { "key": "otherHost", "value": "2099-0003" },
    { "key": "setId", "value": "1" },
    { "key": "code", "value": "" }
  ],
  "item": [
    {
      "name": "Module 1 - Create question set (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Library Mayhem Basics\",\n  \"description\": \"Basic questions\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      }
    },
    {
      "name": "Module 1 - Title too short (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Hi\"\n}"
        },
        "url": "{{baseUrl}}/question-sets"
      }
    },
    {
      "name": "Module 1 - List (200)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "url": "{{baseUrl}}/question-sets"
      }
    },
    {
      "name": "Module 1 - Other host (403)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Demo-User", "value": "{{otherHost}}" }
        ],
        "url": "{{baseUrl}}/question-sets/{{setId}}"
      }
    },
    {
      "name": "Module 1 - Not found (404)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "url": "{{baseUrl}}/question-sets/999"
      }
    },
    {
      "name": "Module 2 - Host starts game (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_set_id\": 1\n}"
        },
        "url": "{{baseUrl}}/sessions"
      }
    },
    {
      "name": "Module 2 - Player joins (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"PlayerOne\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
    {
      "name": "Module 2 - Rejoin (200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"PlayerOne\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
    {
      "name": "Module 2 - Nickname taken (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{otherHost}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"PlayerOne\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    },
    {
      "name": "Module 2 - Start game (200)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{host}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}"
      }
    },
    {
      "name": "Module 2 - Join too late (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Demo-User", "value": "{{otherHost}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"LatePlayer\"\n}"
        },
        "url": "{{baseUrl}}/sessions/{{code}}/players"
      }
    }
  ]
}